# Example of pointing the same suite at an already-deployed instance (app is not started locally).
BASE_URL=https://loanlens.staging.example.com
START_APP=false
API_BASE_URL=https://jsonplaceholder.typicode.com
BROWSER=chromium
HEADLESS=true
SLOW_MO_MS=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900
STEP_TIMEOUT_MS=90000
ACTION_TIMEOUT_MS=15000
API_MAX_RESPONSE_MS=15000
SCREENSHOTS=failure
TRACE=on-failure
