# CI: identical to local but explicit; override any value with a real environment variable.
BASE_URL=http://127.0.0.1:3000
START_APP=true
API_BASE_URL=https://jsonplaceholder.typicode.com
BROWSER=chromium
HEADLESS=true
SLOW_MO_MS=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900
STEP_TIMEOUT_MS=90000
ACTION_TIMEOUT_MS=15000
API_MAX_RESPONSE_MS=15000
SCREENSHOTS=always
TRACE=on-failure
