# Local run: the test hooks start the LoanLens app on BASE_URL automatically.
BASE_URL=http://127.0.0.1:3000
START_APP=true
API_BASE_URL=https://jsonplaceholder.typicode.com

BROWSER=chromium
HEADLESS=true
SLOW_MO_MS=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=900

STEP_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=10000
API_MAX_RESPONSE_MS=10000

# always | failure | off
SCREENSHOTS=always
# on-failure | off
TRACE=on-failure
